<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_page_background"
    android:padding="16dp"
    tools:context=".callActivity">

    <TextView
        android:id="@+id/introductionNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Click on the icons  to contact the following parties:"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/black"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="24dp"/>

    <LinearLayout
        android:id="@+id/linksContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@id/introductionNote"
        android:layout_centerInParent="true"
        android:divider="?android:attr/dividerVertical"
        android:dividerPadding="8dp"
        android:showDividers="middle">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            card_view:cardBackgroundColor="@android:color/transparent"
            android:background="@drawable/main_page_background">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/redCrossLogo"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/redcrosss"
                    android:padding="16dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/redCrossLogo"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/black"
                    android:fontFamily="sans-serif-medium"
                    android:text="Red Cross Kenya"
                    android:textSize="16sp" />

            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            card_view:cardBackgroundColor="@android:color/transparent"
            android:background="@drawable/main_page_background">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/policeLogo"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/policee"
                    android:padding="16dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/policeLogo"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/black"
                    android:fontFamily="sans-serif-medium"
                    android:text="Kenya Police"
                    android:textSize="16sp" />

            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            card_view:cardBackgroundColor="@android:color/transparent"
            android:background="@drawable/main_page_background">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/amnestyInternationalLogo"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/amnestyy"
                    android:padding="16dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/amnestyInternationalLogo"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/black"
                    android:fontFamily="sans-serif-medium"
                    android:text="Amnesty International Kenya"
                    android:textSize="16sp" />

            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            card_view:cardBackgroundColor="@android:color/transparent"
            android:background="@drawable/main_page_background">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/john"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/johnn"
                    android:padding="16dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/john"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/black"
                    android:fontFamily="sans-serif-medium"
                    android:text="St. John's Ambulance"
                    android:textSize="16sp" />

            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            card_view:cardBackgroundColor="@android:color/transparent"
            android:background="@drawable/main_page_background">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/Unicef"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/uniceff"
                    android:padding="16dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/Unicef"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/black"
                    android:fontFamily="sans-serif-medium"
                    android:text="UNICEF Kenya"
                    android:textSize="16sp" />

            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            card_view:cardBackgroundColor="@android:color/transparent"
            android:background="@drawable/main_page_background">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/WHO"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/who"
                    android:padding="16dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/WHO"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/black"
                    android:fontFamily="sans-serif-medium"
                    android:text="World Health Organization"
                    android:textSize="16sp" />

            </RelativeLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</RelativeLayout>
