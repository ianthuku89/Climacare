<?xml version="1.0" encoding="utf-8"?>
<!-- footer_layout.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="horizontal"
    android:layout_below="@id/predictButton"
    android:padding="16dp"
    android:background="@drawable/footer_border">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/button_border"
        android:padding="4dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:gravity="center">

        <ImageButton
            android:id="@+id/historyButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerInside"
            android:src="@drawable/history"
            android:background="@android:color/transparent"
            android:contentDescription="Prediction History" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="History"
            android:textColor="@color/black"
            android:gravity="center"
            android:paddingTop="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/button_border"
        android:padding="4dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:gravity="center">

        <ImageButton
            android:id="@+id/chatBotButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerInside"
            android:src="@drawable/help"
            android:background="@android:color/transparent"
            android:contentDescription="Help" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Help"
            android:textColor="@color/black"
            android:gravity="center"
            android:paddingTop="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/button_border"
        android:padding="4dp"
        android:layout_marginStart="8dp"
        android:orientation="vertical"
        android:gravity="center">

        <ImageButton
            android:id="@+id/callPageButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerInside"
            android:src="@drawable/phone"
            android:background="@android:color/transparent"
            android:contentDescription="Emergency Contacts" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Call"
            android:textColor="@color/black"
            android:gravity="center"
            android:paddingTop="4dp" />
    </LinearLayout>
</LinearLayout>
